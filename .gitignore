__pycache__/
*.pyc

# Build products of the toolchain and the runtime. Everything here is
# regenerated from source and a configure line; nothing in it belongs in
# history.
build/
*.o
*.a
*.so
*.dll
*.exe

# Upstream sources are pinned and fetched, never vendored.
upstream/
src-cache/

# The veneer's feature-test test caches the one vendor features.h it diffs
# against here, fetched at a pinned version and checksummed. Per DR-0002 the
# vendor header is not vendored into history.
veneer/t/ref-cache/

# Per-site or local config: anything with "local" in the name stays out.
# Committed example templates are the exception, since they show what the
# local file should contain.
*local*
!*local*.example.*
# The vendored glibc headers are the other exception: locale.h and friends
# carry "local" in the name and are history, not site config.
!veneer/include/**/*local*
# So does WP-56's locale slice under the wiring: its generated files and
# diff cases are history too.
!veneer/wiring/**/*locale*

# Logs belong in bug reports, not here. The *unredacted* guard also catches a
# raw capture saved under some other extension.
*.log
*unredacted*

# session-monitor run logs. The .smon marker opts this tree into monitoring;
# the JSONL runs under it are per-run and local, never history.
.smon/

# The incremental suite's per-step pass stamps (loader/exec/t/run.sh
# --since-last-pass). A local cache keyed on input content; the ledger is the
# record, not these.
loader/exec/t/.passed/

# doc/Next-Steps.md is a generated dashboard, rewritten every worker run from
# git truth. It is not tracked -- its history was pure churn. Regenerate it with
# bin/refresh-next-steps.py; the tracked source of truth is doc/status/.
doc/Next-Steps.md

# Session scratch, editor backups, crash dumps.
/a/
*~
*.stackdump
