__pycache__/
*.pyc

# Build products of the toolchain and the runtime. Everything here is
# regenerated from source and a configure line; nothing in it belongs in
# history.
build/
*.o
*.a
*.so
*.dll
*.exe

# Upstream sources are pinned and fetched, never vendored.
upstream/
src-cache/

# The veneer's feature-test test caches the one vendor features.h it diffs
# against here, fetched at a pinned version and checksummed. Per DR-0002 the
# vendor header is not vendored into history.
veneer/t/ref-cache/

# Per-site or local config: anything with "local" in the name stays out.
# Committed example templates are the exception, since they show what the
# local file should contain.
*local*
!*local*.example.*

# Logs belong in bug reports, not here. The *unredacted* guard also catches a
# raw capture saved under some other extension.
*.log
*unredacted*

# session-monitor run logs. The .smon marker opts this tree into monitoring;
# the JSONL runs under it are per-run and local, never history.
.smon/
