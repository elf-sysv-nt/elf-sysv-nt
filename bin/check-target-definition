#!/usr/bin/env bash
#
# Turn WP-10's exit criterion into something that either passes or does not.
#
# The criterion reads "every later package that hardcodes one of the five
# cites this document rather than a memory of it", which is a judgment until
# a script makes it a test. This is that script. It greps the tree for each
# literal value in doc/design/target-definition.md and reports any file carrying one
# without also naming the document.
#
# Prose is exempt, and deliberately. doc/ argues about these values, spike/
# measures them, and the three markdown files at the root introduce them;
# none is a consumer, and requiring a design document to cite another design
# document in the same sentence produces citation noise rather than
# traceability. What this covers is everything that gets built or run:
# sources, scripts, specs files, makefiles, macro sets.
#
# The walk is over tracked files. Two reasons, and the second is the one that
# bit: nothing untracked is built or run, so an untracked file cannot be the
# consumer this criterion is about; and a gate whose verdict depends on what a
# session happened to leave in the working tree is not a gate. This one was
# walking the a/ annex and failing on a suite build log -- evidence of a run
# that happened, at real paths against a real target, which is exactly the
# class the transcript exemption below already covers and for the same reason.
# A gate that goes red because somebody saved a log teaches people to ignore
# it. Outside a work tree the walk falls back to find, so -C into an unpacked
# copy still works.
#
# Until WP-11 lands there is nothing outside doc/ and spike/ for it to find,
# so a clean run today means the tree is empty rather than that the tree is
# attributed. That is expected and it is why the count is printed.
#
# Usage:
#   check-target-definition [options]
#
# Options:
#   -C DIR, --directory=DIR  Run as if started in DIR. [default: the repo root]
#   -e PAT, --exclude=PAT    Also skip paths matching this. Repeatable.
#   -t, --terse              One key=value per line, no prose.
#   -q, --quiet              Errors only; the exit code carries the verdict.
#   -v, --verbose            Name every file examined.
#   -d, --debug              Trace execution; implies --verbose.
#   -V, --version            Print the version and exit.
#   -h, --help               Print this message and exit.
#
# Each option is also settable as CHECK_TARGET_DEFINITION_<OPTION>, and the
# option wins over the variable.
#
# Exit codes: 0 every site attributed, 1 at least one is not, 2 usage error.

set -u

prog=check-target-definition
release='check-target-definition 1.0'

here=$(cd "$(dirname "$0")/.." && pwd)

root=${CHECK_TARGET_DEFINITION_DIRECTORY:-$here}
terse=${CHECK_TARGET_DEFINITION_TERSE:-0}
quiet=${CHECK_TARGET_DEFINITION_QUIET:-0}
verbose=${CHECK_TARGET_DEFINITION_VERBOSE:-0}
debug=${CHECK_TARGET_DEFINITION_DEBUG:-0}
extra=${CHECK_TARGET_DEFINITION_EXCLUDE:-}

usage() { awk '/^# Usage:/,/^[^#]/ { if ($0 ~ /^#/) print substr($0, 3) }' "$0"; }

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }

usage_error() { printf '%s: %s\n' "$prog" "$*" >&2; usage >&2; exit 2; }

note() { [ "$quiet" = 1 ] || printf '%s: %s\n' "$prog" "$*" >&2; }

chat() { [ "$verbose" = 1 ] && note "$@"; return 0; }

while [ $# -gt 0 ]; do
    opt=$1; shift
    val=
    case $opt in
        --*=*) val=${opt#*=}; opt=${opt%%=*} ;;
    esac
    takes=0
    case $opt in
        -C|--directory|-e|--exclude) takes=1 ;;
    esac
    if [ "$takes" = 1 ] && [ -z "$val" ]; then
        [ $# -gt 0 ] || usage_error "$opt wants a value"
        val=$1; shift
    fi
    case $opt in
        -C|--directory) root=$val ;;
        -e|--exclude) extra="$extra $val" ;;
        -t|--terse) terse=1 ;;
        -q|--quiet) quiet=1 ;;
        -v|--verbose) verbose=1 ;;
        -d|--debug) debug=1; verbose=1 ;;
        -V|--version) printf '%s\n' "$release"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --) break ;;
        *) usage_error "unknown option $opt" ;;
    esac
done

[ "$debug" = 1 ] && set -x
[ -d "$root" ] || usage_error "no such directory: $root"

record=doc/design/target-definition.md
[ -r "$root/$record" ] || die "$record is missing; WP-10 is what this checks"

# One per line, and each has to be a string a consumer would actually write
# rather than a phrase a document would. "Linux" and "x86_64" are values in
# the record and are not listed: everything on the planet contains them.
literals='x86_64-elfsysvnt-linux-gnu
ld-linux-x86-64.so.2
4.18.0-elfsysvnt
#1 SMP elfsysvnt
.note.elfsysvnt.abi'

cd "$root" || die "cannot enter $root"

# A transcript is exempt for the reason bin/check-roots gives about the same
# class of file: it is evidence of a run that happened, at real paths against a
# real target, and editing one to add a citation falsifies it. The rule is the
# same either way -- attribution belongs on what gets built or run, not on the
# record of what a run saw.
skip() {
    case $1 in
        ./doc/*|./spike/*|./.git/*|./bin/check-target-definition) return 0 ;;
        ./AGENTS.md|./CLAUDE.md|./README.md) return 0 ;;
        *results-*.txt|*trace-*.txt) return 0 ;;
    esac
    for pat in $extra; do
        case $1 in *$pat*) return 0 ;; esac
    done
    return 1
}

examined=0
carrying=0
unattributed=0
offenders=

tmp=$(mktemp -d "${TMPDIR:-/tmp}/$prog.XXXXXX") || die 'cannot create a working directory'
trap 'rm -rf "$tmp"' EXIT
trap 'rm -rf "$tmp"; exit 130' INT TERM

printf '%s\n' "$literals" > "$tmp/literals"

# Tracked files when there are any, the whole tree otherwise. Both lists are
# NUL separated and both are normalised to ./path, because skip()'s patterns
# are written that way and git prints paths without the prefix.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
   git ls-files -z > "$tmp/all" 2>/dev/null && [ -s "$tmp/all" ]; then
    scope=tracked
else
    find . -type f ! -name '*.o' ! -name '*.a' -print0 2>/dev/null > "$tmp/all"
    scope=walked
fi

: > "$tmp/kept"
while IFS= read -r -d '' f; do
    case $f in ./*) ;; *) f=./$f ;; esac
    skip "$f" && continue
    [ -f "$f" ] || continue          # a tracked path can be deleted in the tree
    printf '%s\0' "$f" >> "$tmp/kept"
    examined=$((examined + 1))
    chat "examined: ${f#./}"
done < "$tmp/all"

# One grep over the whole list rather than one grep per literal per file. The
# old shape spawned six processes for every file in the tree, which on this
# host took the gate past fifteen minutes -- long enough that nobody ran it,
# which is how the trunk stayed red. Only the files that carry a value are
# opened a second time, and there are few of those.
: > "$tmp/carriers"
if [ "$examined" -gt 0 ]; then
    xargs -0 grep -l -F -f "$tmp/literals" -- < "$tmp/kept" \
        > "$tmp/carriers" 2>/dev/null
fi

while IFS= read -r f; do
    [ -n "$f" ] || continue
    carrying=$((carrying + 1))
    if grep -qF "$record" "$f" 2>/dev/null; then
        chat "cited: ${f#./}"
    else
        unattributed=$((unattributed + 1))
        offenders="$offenders${offenders:+
}${f#./}"
        note "unattributed: ${f#./}"
    fi
done < "$tmp/carriers"

if [ "$terse" = 1 ]; then
    printf 'scope=%s\nexamined=%d\ncarrying=%d\nunattributed=%d\n' \
        "$scope" "$examined" "$carrying" "$unattributed"
else
    note "$examined $scope files examined, $carrying carry a target value, $unattributed unattributed"
fi

[ "$unattributed" = 0 ] || exit 1
exit 0
