#!/usr/bin/env bash
#
# install-veneer -- put the veneer's libraries where the linker looks.
#
# WP-53 builds libc.so.6 and libc.a; WP-54 builds the eight companions an
# el8 binary names beside them.  Both build into REPO/build and neither
# installs, so this script closes the gap: it runs the two builders and
# copies what they made into the sysroot's usr/lib64, beside WP-14's
# startup files, then writes the unversioned dev names (libc.so, libm.so,
# ...) as symlinks so `-lc' and `-lm' resolve at link time.  el8 ships a
# few of those dev names as linker scripts rather than links; for most the
# distinction buys nothing, but libc.so is the exception: atexit lives in
# libc_nonshared.a, never in libc.so.6, because it must capture the
# registering module's own __dso_handle.  So this script compiles the
# veneer's nonshared sliver, archives it, and writes libc.so as the same
# GROUP script glibc uses.
#
# Usage:
#   install-veneer [options]
#
# Options:
#   -P DIR, --prefix=DIR   Where the toolchain is installed.
#                          [default: $HOME/x-elfsysvnt]
#   -T TRIPLE, --target=TRIPLE
#                          [default: x86_64-elfsysvnt-linux-gnu]
#   -B DIR, --build=DIR    The build root the builders used.
#                          [default: REPO/build]
#   -s, --skip-build       Install what is already built; build nothing.
#   -n, --dry-run          Report and stop.
#
# Exit codes: 0 success, 1 failure, 2 usage error.

set -u

prog=install-veneer
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)

prefix=${INSTALL_VENEER_PREFIX:-$HOME/x-elfsysvnt}
target=${INSTALL_VENEER_TARGET:-x86_64-elfsysvnt-linux-gnu}
build=${INSTALL_VENEER_BUILD:-$root/build}
skip=0
dry=0

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case $1 in
    -P|--prefix) prefix=$2; shift 2 ;;
    -T|--target) target=$2; shift 2 ;;
    -B|--build)  build=$2;  shift 2 ;;
    -s|--skip-build) skip=1; shift ;;
    -n|--dry-run) dry=1; shift ;;
    *) echo "usage: install-veneer [-P DIR] [-T TRIPLE] [-B DIR] [-s] [-n]" >&2; exit 2 ;;
  esac
done

libdir=$prefix/$target/sys-root/usr/lib64
[ -d "$libdir" ] || die "$libdir does not exist; run build-csu first"

if [ "$skip" = 0 ] && [ "$dry" = 0 ]; then
  "$root/veneer/libc/build-libc" -P "$prefix" -B "$build/libc" -q \
    || die "build-libc failed"
  "$root/veneer/companions/build-companions" -P "$prefix" -B "$build/companions" -q \
    || die "build-companions failed"
fi

# The versioned names, exactly as an el8 loader would want them.
set -- "$build/libc/libc.so.6" "$build"/companions/*/lib*.so.*
[ -f "$1" ] || die "nothing built under $build; run without -s first"

if [ "$dry" = 1 ]; then
  for f in "$@" "$build/libc/libc.a"; do echo "$f -> $libdir/"; done
  exit 0
fi

for f in "$@"; do
  [ -f "$f" ] || die "missing $f"
  cp -f "$f" "$libdir/" || die "cannot copy $f"
  chmod 644 "$libdir/$(basename "$f")"
done
cp -f "$build/libc/libc.a" "$libdir/" || die "cannot copy libc.a"
chmod 644 "$libdir/libc.a"

# Dev names: strip the version suffix of each installed soname.
installed=0
for f in "$@"; do
  so=$(basename "$f")
  dev=${so%%.so.*}.so
  ln -sf "$so" "$libdir/$dev" || die "cannot link $dev"
  installed=$((installed+1))
done

# The static sliver, and the linker script that grafts it onto -lc.
cc=$prefix/bin/$target-gcc
ar=$prefix/bin/$target-ar
[ -x "$cc" ] || die "no cross compiler at $cc"
"$cc" -c -O2 -fPIC -o "$build/libc/nonshared.o" "$root/veneer/libc/nonshared.c" \
  || die "cannot compile the nonshared sliver"
rm -f "$libdir/libc_nonshared.a"
"$ar" rcs "$libdir/libc_nonshared.a" "$build/libc/nonshared.o" \
  || die "cannot archive libc_nonshared.a"
chmod 644 "$libdir/libc_nonshared.a"

rm -f "$libdir/libc.so"
cat > "$libdir/libc.so" <<'EOF' || die "cannot write the libc.so linker script"
/* GNU ld script -- see install-veneer.  atexit and at_quick_exit live in
   the archive; everything else in the shared library. */
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( libc.so.6 libc_nonshared.a )
EOF
chmod 644 "$libdir/libc.so"

echo "$installed libraries, libc.a, libc_nonshared.a, and their dev names under $libdir"
