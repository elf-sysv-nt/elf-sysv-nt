diff --git a/sysdeps/unix/sysv/linux/x86_64/clone.S b/sysdeps/unix/sysv/linux/x86_64/clone.S
index 34bebe0c..b24fb8b8 100644
--- a/sysdeps/unix/sysv/linux/x86_64/clone.S
+++ b/sysdeps/unix/sysv/linux/x86_64/clone.S
@@ -73,7 +73,7 @@ ENTRY (__clone)
 	/* End FDE now, because in the child the unwind info will be
 	   wrong.  */
 	cfi_endproc;
-	syscall
+	ENTER_KERNEL
 
 	testq	%rax,%rax
 	jl	SYSCALL_ERROR_LABEL
@@ -89,6 +89,16 @@ L(thread_start):
 	   the outermost frame obviously.  */
 	xorl	%ebp, %ebp
 
+	/* The kernel set this thread's thread-pointer slot; the canary and
+	   pointer-guard slots beside it are this thread's own and empty.
+	   Fill them from the TCB, where the creating thread put the
+	   process's values, before any protected frame runs here.  */
+	movq	%gs:ELFSYSVNT_TP_SLOT, %rax
+	movq	STACK_GUARD(%rax), %rdx
+	movq	%rdx, %gs:ELFSYSVNT_STACK_GUARD_SLOT
+	movq	POINTER_GUARD(%rax), %rdx
+	movq	%rdx, %gs:ELFSYSVNT_POINTER_GUARD_SLOT
+
 	/* Set up arguments for the function call.  */
 	popq	%rax		/* Function to call.  */
 	popq	%rdi		/* Argument.  */
@@ -96,7 +106,7 @@ L(thread_start):
 	/* Call exit with return value from function call. */
 	movq	%rax, %rdi
 	movl	$SYS_ify(exit), %eax
-	syscall
+	ENTER_KERNEL
 	cfi_endproc;
 
 	cfi_startproc;
