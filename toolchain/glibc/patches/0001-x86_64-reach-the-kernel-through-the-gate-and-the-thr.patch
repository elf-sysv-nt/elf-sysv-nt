+   License along with the GNU C Library; if not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#ifndef _LINUX_X86_64_DL_SYSDEP_H
+#define _LINUX_X86_64_DL_SYSDEP_H 1
+
+#include_next <dl-sysdep.h>
+
+/* The kernel is entered through a gate whose address it passes in the
+   auxiliary vector as AT_SYSINFO, the way the i386 kernel passes its
+   vsyscall entry: substrate N of elf-sysv-nt cannot trap the syscall
+   instruction.  _dl_sysdep_start and _dl_aux_init store the value in
+   GLRO(dl_sysinfo), and sysdep.h calls through it.  */
+#define NEED_DL_SYSINFO	1
+
+#ifndef __ASSEMBLER__
+/* There is no instruction to fall back on when the vector carries no
+   gate.  The default is a stub that faults at a named symbol, so that a
+   system call made before the vector was read, or under a kernel that
+   published nothing, stops at _dl_sysinfo_nogate in a backtrace rather
+   than at whatever address zero held.  */
+extern void _dl_sysinfo_nogate (void) attribute_hidden;
+# define DL_SYSINFO_DEFAULT (uintptr_t) _dl_sysinfo_nogate
+# define DL_SYSINFO_IMPLEMENTATION \
+  asm (".text\n\t"							      \
+       ".type _dl_sysinfo_nogate,@function\n\t"				      \
+       ".hidden _dl_sysinfo_nogate\n"					      \
+       CFI_STARTPROC "\n"						      \
+       "_dl_sysinfo_nogate:\n\t"					      \
+       "ud2\n\t"							      \
+       CFI_ENDPROC "\n"							      \
+       ".size _dl_sysinfo_nogate,.-_dl_sysinfo_nogate\n\t"		      \
+       ".previous");
+#endif
+
+#endif	/* dl-sysdep.h */
